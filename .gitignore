# Ignore build output directories
build/
u8g2/
*.old
.cache/
components/
managed_components/
main/secrets.h
.agents/

# Ignore object files and binaries
*.o
*.a
*.elf

# Ignore dependency files
*.d

# Ignore generated files
*.bin
*.map
*.hex

# Ignore logs and temporary files
*.log
*.tmp

